是「卡片不是护身符」，第二行是「不使用就没有意义」；这两行字为奶白色、带深色描边与极轻微的外发光，压在火光与烟雾上依然清晰可读。画面底部居中一行极小的字写着「色彩 · 总力战」，两端各延伸出一条细线。\n\n文字要求。画面中只有上述几处文字，其余地方保持干净，不要额外的乱码字符与多余标签；所有文字必须为清晰的简体中文与拉丁字母，笔画完整、字形准确、不粘连、不镜像，字号层级分明（台词最大、左上角角色名次之、底部小字最小），文字与火光、烟雾和油画质感自然融合，不要水印。\n","negative_prompt":"","cfg":1,"steps":20,"switch":true,"width":1024,"height":1024,"scheduler":"euler","scheduler_1":"simple","seed":908066993307622,"unet_name":"qwen_image2.1\\qwen_image_2.1_int8_convrot.safetensors","clip_name":"qwen3vl_8b_int8_convrot.safetensors","vae_name":"qwen_image_2.1_vae_bf16.safetensors","device":"cpu","dtype":"default"}},{"id":13,"type":"ResolutionSelector","pos":[480,3200],"size":[300,190],"flags":{},"order":4,"mode":0,"showAdvanced":true,"inputs":[{"localized_name":"宽高比","name":"aspect_ratio","type":"COMBO","widget":{"name":"aspect_ratio"},"link":null},{"localized_name":"百万像素","name":"megapixels","type":"FLOAT","widget":{"name":"megapixels"},"link":null},{"localized_name":"倍数","name":"multiple","type":"INT","widget":{"name":"multiple"},"link":null},{"localized_name":"预览","name":"preview","shape":7,"type":"RESOLUTION_PREVIEW","widget":{"name":"preview"},"link":null}],"outputs":[{"localized_name":"宽度","name":"width","type":"INT","links":[670]},{"localized_name":"高度","name":"height","type":"INT","links":[671]}],"properties":{"Node name for S&R":"ResolutionSelector"},"widgets_values":["21:9 (Ultrawide)",1.8,36],"widgets_values_named":{"aspect_ratio":"21:9 (Ultrawide)","megapixels":1.8,"multiple":36}}],"links":[[672,459,0,461,0,"IMAGE"],[670,13,0,459,6,"INT"],[671,13,1,459,7,"INT"],[732,479,0,459,14,"IMAGE"],[734,470,0,479,0,"IMAGE"],[736,481,0,459,15,"IMAGE"],[737,475,0,481,0,"IMAGE"],[738,459,0,482,0,"IMAGE"],[739,479,0,482,1,"IMAGE"]],"groups":[],"definitions":{"subgraphs":[{"id":"bc1c967a-7f6a-4be9-a372-dad16e4f28e3","version":1,"state":{"lastGroupId":37,"lastNodeId":482,"lastLinkId":739,"lastRerouteId":9},"revision":0,"config":{},"name":"Image Edit (Qwen Image 2.1)","inputNode":{"id":-10,"bounding":[-72